NODE_ENV=development
DB_SYNCHRONIZE=true
BCRYPT_SALT_ROUNDS=12
LOG_LEVEL=info
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
REGISTRATION_ENABLED=true
AUTH_PORT=3001
AUTH_DB_PASSWORD=replace-with-generated-secret
AUTH_DATABASE_URL=postgresql://retcon_auth:replace-with-generated-secret@localhost:5433/retcon_auth
JWT_ISSUER=retcon-auth
JWT_AUDIENCE=retcon-api
JWT_PRIVATE_KEY_FILE=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_FILE=.secrets/jwt-public.pem
ACCESS_TOKEN_TTL_SECONDS=900
JWT_CLOCK_TOLERANCE_SECONDS=5
REFRESH_TOKEN_TTL_DAYS=30
HTTP_HOST=0.0.0.0
HTTP_BODY_LIMIT_BYTES=262144
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
HTTP_THROTTLE_TTL_MS=60000
HTTP_THROTTLE_LIMIT=120
DB_POOL_MAX=10
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_MS=2000
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=5000
