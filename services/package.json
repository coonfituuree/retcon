{
  "name": "retcon-backend",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=10.34.0 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write . ../README.md ../CONTRIBUTING.md \"../docs/**/*.md\" \"../.github/**/*.{yml,yaml,md}\"",
    "format:check": "prettier --check . ../README.md ../CONTRIBUTING.md \"../docs/**/*.md\" \"../.github/**/*.{yml,yaml,md}\"",
    "setup:local": "node scripts/setup-local.mjs",
    "infra:up": "docker compose up -d auth-db redis",
    "up": "docker compose up --build -d",
    "down": "docker compose down",
    "dev": "pnpm build && concurrently -k \"pnpm --filter @retcon/auth watch\" \"node --watch --env-file=.env auth/dist/main.js\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0"
  }
}
